      "@id": "sup:Documentation",
      "@type": "owl:Class",
      "rdfs:label": "Documentation",
      "skos:prefLabel": "Documentation",
      "skos:definition": "Published product documentation and knowledge base content that support agents consult to resolve tickets. One instance is one published unit — an article or page — identified by its URL.",
      "rdfs:comment": "Published product documentation and knowledge base content that support agents consult to resolve tickets. One instance is one published unit — an article or page — identified by its URL.",
      "sup:domainType": "Knowledge",
      "sup:status": "Canonical",
      "sup:identityRule": "The published URL is authoritative. Where content exists at several URLs (localised or mirrored), the canonical URL is the identity and the others are recorded as aliases.",
      "sup:sourceFile": "Ontology/Entities/Documentation.md",
      "skos:altLabel": [
        "Article",
        "KB article",
        "Doc",
        "Page",
        "The docs",
        "the wiki",
