      "@id": "sup:Contact",
      "@type": "owl:Class",
      "rdfs:label": "Contact",
      "skos:prefLabel": "Contact",
      "skos:definition": "An individual person at a customer account who is authorised to raise support tickets and use self-service tools. A Contact is a person in their capacity as a customer representative. Internal staff are modelled as `sup:SupportAgent`, `sup:SalesRepresentative` or `sup:CustomerSuccessManager`.",
      "rdfs:comment": "An individual person at a customer account who is authorised to raise support tickets and use self-service tools. A Contact is a person in their capacity as a customer representative. Internal staff are modelled as `sup:SupportAgent`, `sup:SalesRepresentative` or `sup:CustomerSuccessManager`.",
      "sup:domainType": "Customer",
      "sup:status": "Canonical",
      "sup:identityRule": "CRM contact ID is authoritative.",
      "sup:sourceFile": "Ontology/Entities/Contact.md",
      "skos:altLabel": [
