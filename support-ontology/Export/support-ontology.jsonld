      "@id": "sup:CRM",
      "@type": "owl:Class",
      "rdfs:label": "CRM",
      "skos:prefLabel": "CRM",
      "skos:definition": "A customer relationship management system that records tickets. Each distinct CRM instance is a distinct instance of this class, because each carries its own ticket numbering, its own user records, and — critically — its own vocabulary.",
      "rdfs:comment": "A customer relationship management system that records tickets. Each distinct CRM instance is a distinct instance of this class, because each carries its own ticket numbering, its own user records, and — critically — its own vocabulary.",
      "sup:domainType": "Support",
      "sup:status": "Canonical",
      "sup:identityRule": "Natural key: the system code (e.g. `SF_EMEA`, `SF_AMER`). Each org is a separate instance even when several orgs run on the same platform, because the ID spaces and the vocabulary do not carry across.",
      "sup:sourceFile": "Ontology/Entities/CRM.md",
      "skos:altLabel": [
        "Org",
        "Instance",
        "Tenant",
        "Source",
        "System of record",
        "Upstream",
        "Salesforce",
        "the system"
