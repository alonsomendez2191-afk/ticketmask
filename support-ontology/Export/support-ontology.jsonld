        "@value": "1",
        "@type": "xsd:nonNegativeInteger"
      }
    },
    {
      "@id": "sup:tierRank",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "tierRank",
      "rdfs:domain": {
        "@id": "sup:SupportEntitlement"
      },
      "rdfs:range": {
        "@id": "xsd:integer"
      },
      "rdfs:comment": "Higher = more entitled. Standard 1, Premium 2",
      "sup:isRequired": {
        "@value": "true",
        "@type": "xsd:boolean"
      }
    },
    {
      "@id": "_:b162",
      "@type": "owl:Restriction",
      "owl:onProperty": {
        "@id": "sup:tierRank"
      },
      "owl:minCardinality": {
        "@value": "1",
        "@type": "xsd:nonNegativeInteger"
      }
    },
    {
      "@id": "sup:grantsEscalationRight",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "grantsEscalationRight",
      "rdfs:domain": {
        "@id": "sup:SupportEntitlement"
      },
      "rdfs:range": {
        "@id": "xsd:boolean"
      },
      "rdfs:comment": "Whether the tier may demand escalation",
      "sup:isRequired": {
        "@value": "true",
        "@type": "xsd:boolean"
      }
    },
    {
      "@id": "_:b163",
      "@type": "owl:Restriction",
      "owl:onProperty": {
        "@id": "sup:grantsEscalationRight"
      },
      "owl:minCardinality": {
        "@value": "1",
        "@type": "xsd:nonNegativeInteger"
      }
    },
    {
      "@id": "sup:responseTargetHours",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "responseTargetHours",
      "rdfs:domain": {
        "@id": "sup:SupportEntitlement"
      },
      "rdfs:range": {
        "@id": "xsd:integer"
      },
      "rdfs:comment": "Varies by severity — see OQ-06"
    },
    {
      "@id": "sup:ticketNumber",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "ticketNumber",
      "rdfs:domain": {
        "@id": "sup:Ticket"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "rdfs:comment": "CRM case number",
      "sup:isRequired": {
        "@value": "true",
        "@type": "xsd:boolean"
      }
    },
    {
      "@id": "_:b164",
      "@type": "owl:Restriction",
      "owl:onProperty": {
        "@id": "sup:ticketNumber"
      },
      "owl:minCardinality": {
        "@value": "1",
        "@type": "xsd:nonNegativeInteger"
      }
    },
    {
      "@id": "sup:subject",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "subject",
      "rdfs:domain": {
        "@id": "sup:Ticket"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "sup:isRequired": {
        "@value": "true",
        "@type": "xsd:boolean"
      }
    },
    {
      "@id": "_:b165",
      "@type": "owl:Restriction",
      "owl:onProperty": {
        "@id": "sup:subject"
      },
      "owl:minCardinality": {
        "@value": "1",
        "@type": "xsd:nonNegativeInteger"
      }
    },
    {
      "@id": "_:b166",
      "@type": "owl:Restriction",
      "owl:onProperty": {
        "@id": "sup:status"
      },
      "owl:minCardinality": {
        "@value": "1",
        "@type": "xsd:nonNegativeInteger"
      }
    },
    {
      "@id": "sup:openedAt",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "openedAt",
      "rdfs:domain": {
        "@id": "sup:Ticket"
      },
      "rdfs:range": {
        "@id": "xsd:dateTime"
      },
      "sup:isRequired": {
        "@value": "true",
        "@type": "xsd:boolean"
      }
    },
    {
      "@id": "_:b167",
      "@type": "owl:Restriction",
      "owl:onProperty": {
        "@id": "sup:openedAt"
      },
      "owl:minCardinality": {
        "@value": "1",
        "@type": "xsd:nonNegativeInteger"
      }
    },
    {
      "@id": "sup:resolvedAt",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "resolvedAt",
      "rdfs:domain": {
        "@id": "sup:Ticket"
      },
      "rdfs:range": {
        "@id": "xsd:dateTime"
      },
      "rdfs:comment": "Required when status is Resolved or Closed"
    },
    {
      "@id": "sup:resolutionSummary",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "resolutionSummary",
      "rdfs:domain": {
        "@id": "sup:Ticket"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "sup:CRM_SF",
      "@type": [
        "owl:NamedIndividual",
        "sup:CRM"
      ],
      "rdfs:label": "SF",
      "skos:notation": "SF",
      "sup:systemName": "Salesforce",
      "sup:ticketTermUsed": "Case",
      "sup:isAuthoritative": "Yes",
      "sup:sourceOfThisEntry": "Example: Case is the platform's own object name"
    },
    {
      "@id": "sup:CRM_ZD",
      "@type": [
        "owl:NamedIndividual",
        "sup:CRM"
      ],
      "rdfs:label": "ZD",
      "skos:notation": "ZD",
      "sup:systemName": "Zendesk",
      "sup:ticketTermUsed": "Ticket",
      "sup:isAuthoritative": "Yes",
      "sup:sourceOfThisEntry": "Example: Ticket is the platform's own object name"
    },
    {
      "@id": "sup:Region_EMEA",
      "@type": [
        "owl:NamedIndividual",
        "sup:Region"
      ],
      "rdfs:label": "Europe, Middle East and Africa",
      "skos:notation": "EMEA"
    },
    {
      "@id": "sup:Region_NA",
      "@type": [
        "owl:NamedIndividual",
        "sup:Region"
      ],
      "rdfs:label": "North America",
      "skos:notation": "NA"
    },
    {
      "@id": "sup:Region_APAC",
      "@type": [
        "owl:NamedIndividual",
        "sup:Region"
      ],
      "rdfs:label": "Asia Pacific",
      "skos:notation": "APAC"
    },
    {
      "@id": "sup:Region_LATAM",
      "@type": [
        "owl:NamedIndividual",
        "sup:Region"
      ],
      "rdfs:label": "Latin America",
      "skos:notation": "LATAM"
    },
    {
      "@id": "sup:SeverityLevel_S1",
      "@type": [
        "owl:NamedIndividual",
        "sup:SeverityLevel"
      ],
      "rdfs:label": "S1",
      "skos:notation": "S1",
      "sup:rank": "1",
      "sup:name": "System Down",
      "skos:altLabel": [
        "P1",
        "Critical",
        "Urgent",
        "1"
      ]
    },
    {
      "@id": "sup:SeverityLevel_S2",
      "@type": [
        "owl:NamedIndividual",
        "sup:SeverityLevel"
      ],
      "rdfs:label": "S2",
      "skos:notation": "S2",
      "sup:rank": "2",
      "sup:name": "Work Stoppage",
      "skos:altLabel": [
        "P2",
        "High",
        "2"
      ]
    },
    {
      "@id": "sup:SeverityLevel_S3",
      "@type": [
        "owl:NamedIndividual",
        "sup:SeverityLevel"
      ],
      "rdfs:label": "S3",
      "skos:notation": "S3",
      "sup:rank": "3",
      "sup:name": "Medium",
      "skos:altLabel": [
        "P3",
        "Medium",
        "Normal",
        "3"
      ]
    },
    {
      "@id": "sup:SeverityLevel_S4",
      "@type": [
        "owl:NamedIndividual",
        "sup:SeverityLevel"
      ],
      "rdfs:label": "S4",
      "skos:notation": "S4",
      "sup:rank": "4",
      "sup:name": "Low",
      "skos:altLabel": [
        "P4",
        "Low",
        "Minor",
        "4"
      ]
    },
    {
      "@id": "sup:SupportEntitlement_Standard",
      "@type": [
        "owl:NamedIndividual",
        "sup:SupportEntitlement"
      ],
      "rdfs:label": "Standard",
      "skos:notation": "Standard",
      "sup:tierCode": "STANDARD",
      "skos:altLabel": [
        "Basic",
        "Included Support\" — usage unverified",
        "see OQ-07"
      ]
    },
    {
      "@id": "sup:SupportEntitlement_Premium",
      "@type": [
        "owl:NamedIndividual",
        "sup:SupportEntitlement"
      ],
      "rdfs:label": "Premium",
      "skos:notation": "Premium",
      "sup:tierCode": "PREMIUM",
      "skos:altLabel": [
        "Platinum Support\" for the products that use that naming — see sup:Product.usesPlatinumNaming. Same tier",
        "different label."
      ]
    },
    {
      "@id": "sup:C-01",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-01",
      "rdfs:label": "C-01",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "Every Account is located in exactly one Region.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-02",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-02",
      "rdfs:label": "C-02",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "Every Account has exactly one SupportEntitlement at a given point in time.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-03",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-03",
      "rdfs:label": "C-03",
      "sup:enforcementLevel": "Retired",
      "sup:constraintText": "hasSubRegion transitive and acyclic",
      "sup:status": "Retired",
      "sup:constraintNote": "Sub-regions removed — regions are flat."
    },
    {
      "@id": "sup:C-04",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-04",
      "rdfs:label": "C-04",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "Every Ticket has exactly one Account, exactly one SeverityLevel, and exactly one Product.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-05",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-05",
      "rdfs:label": "C-05",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "A Ticket may carry a Jira reference only through an Escalation. A Jira ID on a ticket with no escalation record is invalid — the link exists but the reason, the author and the date have been lost.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-06",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-06",
      "rdfs:label": "C-06",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "A Ticket with status = Escalated has at least one open Escalation.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-07",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-07",
      "rdfs:label": "C-07",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "Every Account has exactly one SalesRepresentative.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-08",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-08",
      "rdfs:label": "C-08",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "An Account may have a CSM only if isStrategic = true. Note the direction: strategic permits a CSM, it does not require one. A strategic account with no CSM is valid (awaiting assignment); a non-strategic account with a CSM is not.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-09",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-09",
      "rdfs:label": "C-09",
      "sup:enforcementLevel": "Soft",
      "sup:constraintText": "An Account with accountStatus = Active holds at least one active License.",
      "sup:status": "Active",
      "sup:constraintNote": "Accounts marked active after everything lapsed."
    },
    {
      "@id": "sup:C-10",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-10",
      "rdfs:label": "C-10",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "Every Region is covered by at least one SalesRepresentative.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-11",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-11",
      "rdfs:label": "C-11",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "The SupportEntitlement tier set is closed at STANDARD and PREMIUM. A value that does not resolve to one of these after alias resolution is a data error or an alias gap, never a new tier.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-12",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-12",
      "rdfs:label": "C-12",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "grantsEscalationRight is true only for the PREMIUM tier.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-13",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-13",
      "rdfs:label": "C-13",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "License.endDate, when present, is later than startDate.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-14",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-14",
      "rdfs:label": "C-14",
      "sup:enforcementLevel": "Soft",
      "sup:constraintText": "A Ticket's product should be covered by an active License at the time it was opened.",
      "sup:status": "Active",
      "sup:constraintNote": "Out-of-maintenance support requests. Legitimate and common — flag, never reject."
    },
    {
      "@id": "sup:C-15",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-15",
      "rdfs:label": "C-15",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "Every Contact belongs to exactly one Account.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-16",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-16",
      "rdfs:label": "C-16",
      "sup:enforcementLevel": "Soft",
      "sup:constraintText": "A Ticket's submitting Contact must belong to the Ticket's Account.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-17",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-17",
      "rdfs:label": "C-17",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "Only a Contact with isSupportAuthorised = true may submit a Ticket.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-18",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-18",
      "rdfs:label": "C-18",
      "sup:enforcementLevel": "Retired",
      "sup:constraintText": "Every Brand declares its three vocabulary properties",
      "sup:status": "Retired",
      "sup:constraintNote": "Brand removed; replaced by C-51 on Product and C-50 on CRM."
    },
    {
      "@id": "sup:C-19",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-19",
      "rdfs:label": "C-19",
      "sup:enforcementLevel": "Retired",
      "sup:constraintText": "Every ProductLine belongs to one Brand",
      "sup:status": "Retired",
      "sup:constraintNote": "Both classes removed."
    },
    {
      "@id": "sup:C-20",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-20",
      "rdfs:label": "C-20",
      "sup:enforcementLevel": "Retired",
      "sup:constraintText": "ProductLine naming agrees with its Brand",
      "sup:status": "Retired",
      "sup:constraintNote": "Both classes removed."
    },
    {
      "@id": "sup:C-21",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-21",
      "rdfs:label": "C-21",
      "sup:enforcementLevel": "Retired",
      "sup:constraintText": "Every Product belongs to one ProductLine",
      "sup:status": "Retired",
      "sup:constraintNote": "ProductLine removed; Product is now flat."
    },
    {
      "@id": "sup:C-22",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-22",
      "rdfs:label": "C-22",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "A Product with lifecycleStatus = EndOfLife must have an endOfLifeDate.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-23",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-23",
      "rdfs:label": "C-23",
      "sup:enforcementLevel": "Advisory",
      "sup:constraintText": "Documentation describing an EndOfLife product is a retirement candidate.",
      "sup:status": "Active",
      "sup:constraintNote": "Feeds the KB evaluation process."
    },
    {
      "@id": "sup:C-24",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-24",
      "rdfs:label": "C-24",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "Ticket.resolvedAt is required when status is Resolved or Closed, and must not precede openedAt.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-25",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-25",
      "rdfs:label": "C-25",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "The SeverityLevel set is closed at S1–S4. A product-specific value that does not resolve is an alias gap to record in 03-Vocabulary-and-Equivalence.md, not a fifth level.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-26",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-26",
      "rdfs:label": "C-26",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "Severity comparisons, filters and sorts operate on levelRank only — never on the customer-facing label. \"High\" > \"Critical\" is true as a string comparison and false as a fact.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-27",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-27",
      "rdfs:label": "C-27",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "Every Escalation produces exactly one JiraIssue.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-28",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-28",
      "rdfs:label": "C-28",
      "sup:enforcementLevel": "Advisory",
      "sup:constraintText": "An Escalation of type Bug should have reproductionSteps.",
      "sup:status": "Active",
      "sup:constraintNote": "Escalations development will bounce back."
    },
    {
      "@id": "sup:C-29",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-29",
      "rdfs:label": "C-29",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "Only a SupportAgent may create an Escalation. Not a CSM, not a sales rep.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-30",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-30",
      "rdfs:label": "C-30",
      "sup:enforcementLevel": "Retired",
      "sup:constraintText": "Role instances disjoint, persons not",
      "sup:status": "Retired",
      "sup:constraintNote": "Person removed; replaced by C-52."
    },
    {
      "@id": "sup:C-31",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-31",
      "rdfs:label": "C-31",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "A Ticket is assigned to at most one SupportAgent at a time.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-32",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-32",
      "rdfs:label": "C-32",
      "sup:enforcementLevel": "Soft",
      "sup:constraintText": "An inactive SupportAgent must not hold open tickets.",
      "sup:status": "Active",
      "sup:constraintNote": "Tickets orphaned when someone leaves. Real, common, and invisible until a customer chases."
    },
    {
      "@id": "sup:C-33",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-33",
      "rdfs:label": "C-33",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "Every JiraIssue in scope traces back to at least one Escalation. Engineering-initiated issues are out of scope and must not be loaded.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-34",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-34",
      "rdfs:label": "C-34",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "JiraIssue.isResolved is derived from a per-project status mapping, not from the raw status string. Jira projects use different workflows and \"Done\" is not universal.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-35",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-35",
      "rdfs:label": "C-35",
      "sup:enforcementLevel": "Soft",
      "sup:constraintText": "A resolved JiraIssue with unresolved originating Tickets.",
      "sup:status": "Active",
      "sup:constraintNote": "The fix shipped and nobody told the customer. Probably the highest-value check here."
    },
    {
      "@id": "sup:C-36",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-36",
      "rdfs:label": "C-36",
      "sup:enforcementLevel": "Retired",
      "sup:constraintText": "Every JiraIssue owned by one DevelopmentTeam",
      "sup:status": "Retired",
      "sup:constraintNote": "DevelopmentTeam out of scope."
    },
    {
      "@id": "sup:C-37",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-37",
      "rdfs:label": "C-37",
      "sup:enforcementLevel": "Retired",
      "sup:constraintText": "Every Product has an owning DevelopmentTeam",
      "sup:status": "Retired",
      "sup:constraintNote": "DevelopmentTeam out of scope."
    },
    {
      "@id": "sup:C-38",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-38",
      "rdfs:label": "C-38",
      "sup:enforcementLevel": "Retired",
      "sup:constraintText": "AI-indexed articles must be public",
      "sup:status": "Retired",
      "sup:constraintNote": "AIAssistant deferred."
    },
    {
      "@id": "sup:C-39",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-39",
      "rdfs:label": "C-39",
      "sup:enforcementLevel": "Retired",
      "sup:constraintText": "Articles with no inbound link are orphans",
      "sup:status": "Retired",
      "sup:constraintNote": "Article link graph left to the KB evaluation tooling."
    },
    {
      "@id": "sup:C-40",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-40",
      "rdfs:label": "C-40",
      "sup:enforcementLevel": "Advisory",
      "sup:constraintText": "Documentation not reviewed in 24 months is a review candidate.",
      "sup:status": "Active",
      "sup:constraintNote": "Stale content agents are still trusting."
    },
    {
      "@id": "sup:C-41",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-41",
      "rdfs:label": "C-41",
      "sup:enforcementLevel": "Retired",
      "sup:constraintText": "No article may be its own ancestor",
      "sup:status": "Retired",
      "sup:constraintNote": "Article link graph removed."
    },
    {
      "@id": "sup:C-42",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-42",
      "rdfs:label": "C-42",
      "sup:enforcementLevel": "Retired",
      "sup:constraintText": "Every AIAssistant is grounded in ≥1 article",
      "sup:status": "Retired",
      "sup:constraintNote": "AIAssistant deferred."
    },
    {
      "@id": "sup:C-43",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-43",
      "rdfs:label": "C-43",
      "sup:enforcementLevel": "Retired",
      "sup:constraintText": "Article changes trigger re-indexing",
      "sup:status": "Retired",
      "sup:constraintNote": "AIAssistant deferred."
    },
    {
      "@id": "sup:C-44",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-44",
      "rdfs:label": "C-44",
      "sup:enforcementLevel": "Retired",
      "sup:constraintText": "Unemployed Person holds no active roles",
      "sup:status": "Retired",
      "sup:constraintNote": "Person removed."
    },
    {
      "@id": "sup:C-45",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-45",
      "rdfs:label": "C-45",
      "sup:enforcementLevel": "Retired",
      "sup:constraintText": "Every role instance held by exactly one Person",
      "sup:status": "Retired",
      "sup:constraintNote": "Person removed."
    },
    {
      "@id": "sup:C-46",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-46",
      "rdfs:label": "C-46",
      "sup:enforcementLevel": "Soft",
      "sup:constraintText": "An Account's SalesRepresentative must cover the Account's Region. This is \"assigned depending on the region\" made checkable — and it is the constraint most likely to fail after a territory reshuffle.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-47",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-47",
      "rdfs:label": "C-47",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "An Account has at most one CustomerSuccessManager.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-48",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-48",
      "rdfs:label": "C-48",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "Every Ticket is recorded in exactly one CRM.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-49",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-49",
      "rdfs:label": "C-49",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "A fact from a CRM with isAuthoritative = false must not override a fact from an authoritative system for the same property. Mirrors lag.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-50",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-50",
      "rdfs:label": "C-50",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "Every CRM declares ticketTermUsed. A system whose vocabulary is unknown cannot have its records safely translated.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-51",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-51",
      "rdfs:label": "C-51",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "Every Product declares usesPlatinumNaming and severityTermUsed. A product whose support vocabulary is unknown cannot have its tickets safely compared against another product's.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-52",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-52",
      "rdfs:label": "C-52",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "SupportAgent, SalesRepresentative and CustomerSuccessManager are pairwise disjoint. These are three distinct jobs in the support and commercial organization.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-53",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-53",
      "rdfs:label": "C-53",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "Every License is bound to exactly one SupportEntitlement.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-54",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-54",
      "rdfs:label": "C-54",
      "sup:enforcementLevel": "Soft",
      "sup:constraintText": "A License's SupportEntitlement should match its Account's SupportEntitlement.",
      "sup:status": "Active",
      "sup:constraintNote": "The model's own open question, made checkable. If accounts routinely hold licenses at different tiers, entitlement belongs on the license and C-02 is wrong. Flagging rather than rejecting means the first real violation tells us which model is right, instead of the data being quietly reshaped to fit our guess. See OQ-42."
    },
    {
      "@id": "sup:C-55",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-55",
      "rdfs:label": "C-55",
      "sup:enforcementLevel": "Soft",
      "sup:constraintText": "Every Documentation instance describes exactly one Product. Cross-product overview pages legitimately exist, so this flags rather than rejects.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-56",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-56",
      "rdfs:label": "C-56",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "Every Ticket has exactly one SLA, determined by its SeverityLevel and Account's SupportEntitlement.",
      "sup:status": "Active"
    },
    {
      "@id": "sup:C-57",
      "@type": [
        "owl:NamedIndividual",
        "sup:Constraint"
      ],
      "sup:constraintId": "C-57",
      "rdfs:label": "C-57",
      "sup:enforcementLevel": "Hard",
      "sup:constraintText": "A Ticket raised by a Partner must belong to an Account that the Partner represents.",
      "sup:status": "Active"
    },
    {
