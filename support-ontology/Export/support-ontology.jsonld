    {
      "@id": "sup:Ticket",
      "@type": "owl:Class",
      "rdfs:label": "Ticket",
      "skos:prefLabel": "Ticket",
      "skos:definition": "A single recorded request for support from a customer account, tracked from submission to resolution. One ticket represents one customer problem. It is owned by exactly one account, assigned to at most one agent at a time, carries exactly one severity, is governed by exactly one SLA, and may be escalated to development. It may be submitted by a Contact at the account or, where the customer buys through one, by a Partner acting on the account's behalf.",
      "rdfs:comment": "A single recorded request for support from a customer account, tracked from submission to resolution. One ticket represents one customer problem. It is owned by exactly one account, assigned to at most one agent at a time, carries exactly one severity, is governed by exactly one SLA, and may be escalated to development. It may be submitted by a Contact at the account or, where the customer buys through one, by a Partner acting on the account's behalf.",
      "sup:domainType": "Support",
      "sup:status": "Canonical",
      "sup:identityRule": "The CRM ticket/case number is authoritative. Ticket numbers are unique within a CRM but not across CRMs — a fully qualified ticket identity is `systemCode` + `ticketNumber`. This is a real collision risk in reporting.",
      "sup:sourceFile": "Ontology/Entities/Ticket.md",
      "skos:altLabel": [
        "Case",
        "Incident",
        "SR",
        "Service Request"
      ],
