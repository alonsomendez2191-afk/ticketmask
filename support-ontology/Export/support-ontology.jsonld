      "@id": "sup:Escalation",
      "@type": "owl:Class",
      "rdfs:label": "Escalation",
      "skos:prefLabel": "Escalation",
      "skos:definition": "The act of a support agent referring a ticket to development because it has been identified as a defect or as a request for new functionality. The Escalation produces a Jira issue and is the only legitimate way a Jira ID becomes associated with a ticket.",
      "rdfs:comment": "The act of a support agent referring a ticket to development because it has been identified as a defect or as a request for new functionality. The Escalation produces a Jira issue and is the only legitimate way a Jira ID becomes associated with a ticket.",
      "sup:domainType": "Support",
      "sup:status": "Canonical",
      "sup:identityRule": "Surrogate: generated UUID. There is no natural key — the same ticket can be escalated more than once, and the same Jira issue can receive escalations from many tickets.",
      "sup:sourceFile": "Ontology/Entities/Escalation.md",
      "skos:altLabel": [
        "Bug report",
