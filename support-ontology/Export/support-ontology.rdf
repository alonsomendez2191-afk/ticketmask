  <rdf:Description rdf:about="https://ontology.local/support#SLA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>SLA</rdfs:label>
    <skos:prefLabel>SLA</skos:prefLabel>
    <skos:definition>The Service Level Agreement that governs a ticket, dictating the target times for response and resolution. An SLA is determined by the severity of the ticket and the entitlement of the customer account. Support agents are measured against their ability to meet these SLA targets.</skos:definition>
    <rdfs:comment>The Service Level Agreement that governs a ticket, dictating the target times for response and resolution. An SLA is determined by the severity of the ticket and the entitlement of the customer account. Support agents are measured against their ability to meet these SLA targets.</rdfs:comment>
    <sup:domainType>Support</sup:domainType>
    <sup:status>Proposed</sup:status>
    <sup:identityRule>A composite of `severityLevel` + `entitlementTier`.</sup:identityRule>
    <sup:sourceFile>Ontology/Entities/SLA.md</sup:sourceFile>
