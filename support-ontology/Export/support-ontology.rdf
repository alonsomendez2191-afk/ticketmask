  <rdf:Description rdf:about="https://ontology.local/support#CRM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>CRM</rdfs:label>
    <skos:prefLabel>CRM</skos:prefLabel>
    <skos:definition>A customer relationship management system that records tickets. Each distinct CRM instance is a distinct instance of this class, because each carries its own ticket numbering, its own user records, and — critically — its own vocabulary.</skos:definition>
    <rdfs:comment>A customer relationship management system that records tickets. Each distinct CRM instance is a distinct instance of this class, because each carries its own ticket numbering, its own user records, and — critically — its own vocabulary.</rdfs:comment>
    <sup:domainType>Support</sup:domainType>
    <sup:status>Canonical</sup:status>
    <sup:identityRule>Natural key: the system code (e.g. `SF_EMEA`, `SF_AMER`). Each org is a separate instance even when several orgs run on the same platform, because the ID spaces and the vocabulary do not carry across.</sup:identityRule>
    <sup:sourceFile>Ontology/Entities/CRM.md</sup:sourceFile>
    <skos:altLabel>Org</skos:altLabel>
    <skos:altLabel>Instance</skos:altLabel>
    <skos:altLabel>Tenant</skos:altLabel>
