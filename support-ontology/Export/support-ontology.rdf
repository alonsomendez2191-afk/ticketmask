    <skos:altLabel>Source</skos:altLabel>
    <skos:altLabel>System of record</skos:altLabel>
    <skos:altLabel>Upstream</skos:altLabel>
    <sup:hasAlias rdf:nodeID="b10"/>
    <skos:altLabel>Salesforce</skos:altLabel>
    <skos:altLabel>the system</skos:altLabel>
