    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>SalesRepresentative</rdfs:label>
    <skos:prefLabel>SalesRepresentative</skos:prefLabel>
    <skos:definition>An internal individual who commercially owns a set of accounts. Assignment is driven by region: an account's sales representative is drawn from the representatives covering that account's region.</skos:definition>
    <rdfs:comment>An internal individual who commercially owns a set of accounts. Assignment is driven by region: an account's sales representative is drawn from the representatives covering that account's region.</rdfs:comment>
    <sup:domainType>Customer</sup:domainType>
    <sup:status>Canonical</sup:status>
    <sup:identityRule>The CRM user ID is authoritative.</sup:identityRule>
