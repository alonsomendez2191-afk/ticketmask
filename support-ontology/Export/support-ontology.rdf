  <rdf:Description rdf:about="https://ontology.local/support#Partner">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Partner</rdfs:label>
    <skos:prefLabel>Partner</skos:prefLabel>
    <skos:definition>An Independent Software Vendor (ISV) or partner organization that represents one or more accounts. Partners can submit and manage support tickets on behalf of the customers they represent.</skos:definition>
    <rdfs:comment>An Independent Software Vendor (ISV) or partner organization that represents one or more accounts. Partners can submit and manage support tickets on behalf of the customers they represent.</rdfs:comment>
