  <rdf:Description rdf:about="https://ontology.local/support#License">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>License</rdfs:label>
    <skos:prefLabel>License</skos:prefLabel>
    <skos:definition>A grant of the right to use a specific product, held by a specific account, for a defined period and quantity. The license is what makes a support request legitimate: an account may only raise tickets about products it is licensed for.</skos:definition>
    <rdfs:comment>A grant of the right to use a specific product, held by a specific account, for a defined period and quantity. The license is what makes a support request legitimate: an account may only raise tickets about products it is licensed for.</rdfs:comment>
    <sup:domainType>Customer</sup:domainType>
    <sup:status>Canonical</sup:status>
    <sup:identityRule>Composite: `accountId` + `productId` + `startDate`. A renewal produces a new License instance rather than mutating the existing one, so that historical coverage questions stay answerable.</sup:identityRule>
    <sup:sourceFile>Ontology/Entities/License.md</sup:sourceFile>
    <skos:altLabel>Asset</skos:altLabel>
