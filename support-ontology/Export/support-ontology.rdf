  <rdf:Description rdf:about="https://ontology.local/support#SupportAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>SupportAgent</rdfs:label>
    <skos:prefLabel>SupportAgent</skos:prefLabel>
    <skos:definition>An internal member of the support organization who is assigned tickets, resolves them using documentation, and escalates to development when a ticket is caused by a defect or requires new functionality.</skos:definition>
    <rdfs:comment>An internal member of the support organization who is assigned tickets, resolves them using documentation, and escalates to development when a ticket is caused by a defect or requires new functionality.</rdfs:comment>
    <sup:domainType>Support</sup:domainType>
    <sup:status>Canonical</sup:status>
    <sup:identityRule>The CRM user ID is authoritative. Agents appearing in more than one CRM are matched on corporate email.</sup:identityRule>
    <sup:sourceFile>Ontology/Entities/SupportAgent.md</sup:sourceFile>
    <skos:altLabel>Case owner</skos:altLabel>
    <skos:altLabel>Assigned to</skos:altLabel>
