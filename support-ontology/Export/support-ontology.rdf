  <rdf:Description rdf:about="https://ontology.local/support#Contact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Contact</rdfs:label>
    <skos:prefLabel>Contact</skos:prefLabel>
    <skos:definition>An individual person at a customer account who is authorised to raise support tickets and use self-service tools. A Contact is a person in their capacity as a customer representative. Internal staff are modelled as `sup:SupportAgent`, `sup:SalesRepresentative` or `sup:CustomerSuccessManager`.</skos:definition>
    <rdfs:comment>An individual person at a customer account who is authorised to raise support tickets and use self-service tools. A Contact is a person in their capacity as a customer representative. Internal staff are modelled as `sup:SupportAgent`, `sup:SalesRepresentative` or `sup:CustomerSuccessManager`.</rdfs:comment>
    <sup:domainType>Customer</sup:domainType>
    <sup:status>Canonical</sup:status>
    <sup:identityRule>CRM contact ID is authoritative.</sup:identityRule>
    <sup:sourceFile>Ontology/Entities/Contact.md</sup:sourceFile>
    <skos:altLabel>Contact</skos:altLabel>
