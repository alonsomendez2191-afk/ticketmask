    <sup:constraintId>C-02</sup:constraintId>
    <rdfs:label>C-02</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>Every Account has exactly one SupportEntitlement at a given point in time.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-03</sup:constraintId>
    <rdfs:label>C-03</rdfs:label>
    <sup:enforcementLevel>Retired</sup:enforcementLevel>
    <sup:constraintText>hasSubRegion transitive and acyclic</sup:constraintText>
    <sup:status>Retired</sup:status>
    <sup:constraintNote>Sub-regions removed — regions are flat.</sup:constraintNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-04">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-04</sup:constraintId>
    <rdfs:label>C-04</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>Every Ticket has exactly one Account, exactly one SeverityLevel, and exactly one Product.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-05">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-05</sup:constraintId>
    <rdfs:label>C-05</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>A Ticket may carry a Jira reference only through an Escalation. A Jira ID on a ticket with no escalation record is invalid — the link exists but the reason, the author and the date have been lost.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-06">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-06</sup:constraintId>
    <rdfs:label>C-06</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>A Ticket with status = Escalated has at least one open Escalation.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-07">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-07</sup:constraintId>
    <rdfs:label>C-07</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>Every Account has exactly one SalesRepresentative.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-08">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-08</sup:constraintId>
    <rdfs:label>C-08</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>An Account may have a CSM only if isStrategic = true. Note the direction: strategic permits a CSM, it does not require one. A strategic account with no CSM is valid (awaiting assignment); a non-strategic account with a CSM is not.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-09">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-09</sup:constraintId>
    <rdfs:label>C-09</rdfs:label>
    <sup:enforcementLevel>Soft</sup:enforcementLevel>
    <sup:constraintText>An Account with accountStatus = Active holds at least one active License.</sup:constraintText>
    <sup:status>Active</sup:status>
    <sup:constraintNote>Accounts marked active after everything lapsed.</sup:constraintNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-10">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-10</sup:constraintId>
    <rdfs:label>C-10</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>Every Region is covered by at least one SalesRepresentative.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-11">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-11</sup:constraintId>
    <rdfs:label>C-11</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>The SupportEntitlement tier set is closed at STANDARD and PREMIUM. A value that does not resolve to one of these after alias resolution is a data error or an alias gap, never a new tier.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-12">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-12</sup:constraintId>
    <rdfs:label>C-12</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>grantsEscalationRight is true only for the PREMIUM tier.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-13">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-13</sup:constraintId>
    <rdfs:label>C-13</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>License.endDate, when present, is later than startDate.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-14">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-14</sup:constraintId>
    <rdfs:label>C-14</rdfs:label>
    <sup:enforcementLevel>Soft</sup:enforcementLevel>
    <sup:constraintText>A Ticket's product should be covered by an active License at the time it was opened.</sup:constraintText>
    <sup:status>Active</sup:status>
    <sup:constraintNote>Out-of-maintenance support requests. Legitimate and common — flag, never reject.</sup:constraintNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-15">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-15</sup:constraintId>
    <rdfs:label>C-15</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>Every Contact belongs to exactly one Account.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-16">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-16</sup:constraintId>
    <rdfs:label>C-16</rdfs:label>
    <sup:enforcementLevel>Soft</sup:enforcementLevel>
    <sup:constraintText>A Ticket's submitting Contact must belong to the Ticket's Account.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-17">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-17</sup:constraintId>
    <rdfs:label>C-17</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>Only a Contact with isSupportAuthorised = true may submit a Ticket.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-18">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-18</sup:constraintId>
    <rdfs:label>C-18</rdfs:label>
    <sup:enforcementLevel>Retired</sup:enforcementLevel>
    <sup:constraintText>Every Brand declares its three vocabulary properties</sup:constraintText>
    <sup:status>Retired</sup:status>
    <sup:constraintNote>Brand removed; replaced by C-51 on Product and C-50 on CRM.</sup:constraintNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-19">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-19</sup:constraintId>
    <rdfs:label>C-19</rdfs:label>
    <sup:enforcementLevel>Retired</sup:enforcementLevel>
    <sup:constraintText>Every ProductLine belongs to one Brand</sup:constraintText>
    <sup:status>Retired</sup:status>
    <sup:constraintNote>Both classes removed.</sup:constraintNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-20">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-20</sup:constraintId>
    <rdfs:label>C-20</rdfs:label>
    <sup:enforcementLevel>Retired</sup:enforcementLevel>
    <sup:constraintText>ProductLine naming agrees with its Brand</sup:constraintText>
    <sup:status>Retired</sup:status>
    <sup:constraintNote>Both classes removed.</sup:constraintNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-21">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-21</sup:constraintId>
    <rdfs:label>C-21</rdfs:label>
    <sup:enforcementLevel>Retired</sup:enforcementLevel>
    <sup:constraintText>Every Product belongs to one ProductLine</sup:constraintText>
    <sup:status>Retired</sup:status>
    <sup:constraintNote>ProductLine removed; Product is now flat.</sup:constraintNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-22">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-22</sup:constraintId>
    <rdfs:label>C-22</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>A Product with lifecycleStatus = EndOfLife must have an endOfLifeDate.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-23">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-23</sup:constraintId>
    <rdfs:label>C-23</rdfs:label>
    <sup:enforcementLevel>Advisory</sup:enforcementLevel>
    <sup:constraintText>Documentation describing an EndOfLife product is a retirement candidate.</sup:constraintText>
    <sup:status>Active</sup:status>
    <sup:constraintNote>Feeds the KB evaluation process.</sup:constraintNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-24">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-24</sup:constraintId>
    <rdfs:label>C-24</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>Ticket.resolvedAt is required when status is Resolved or Closed, and must not precede openedAt.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-25">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-25</sup:constraintId>
    <rdfs:label>C-25</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>The SeverityLevel set is closed at S1–S4. A product-specific value that does not resolve is an alias gap to record in 03-Vocabulary-and-Equivalence.md, not a fifth level.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-26">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-26</sup:constraintId>
    <rdfs:label>C-26</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>Severity comparisons, filters and sorts operate on levelRank only — never on the customer-facing label. "High" &gt; "Critical" is true as a string comparison and false as a fact.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-27">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-27</sup:constraintId>
    <rdfs:label>C-27</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>Every Escalation produces exactly one JiraIssue.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-28">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-28</sup:constraintId>
    <rdfs:label>C-28</rdfs:label>
    <sup:enforcementLevel>Advisory</sup:enforcementLevel>
    <sup:constraintText>An Escalation of type Bug should have reproductionSteps.</sup:constraintText>
    <sup:status>Active</sup:status>
    <sup:constraintNote>Escalations development will bounce back.</sup:constraintNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-29">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-29</sup:constraintId>
    <rdfs:label>C-29</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>Only a SupportAgent may create an Escalation. Not a CSM, not a sales rep.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-30">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-30</sup:constraintId>
    <rdfs:label>C-30</rdfs:label>
    <sup:enforcementLevel>Retired</sup:enforcementLevel>
    <sup:constraintText>Role instances disjoint, persons not</sup:constraintText>
    <sup:status>Retired</sup:status>
    <sup:constraintNote>Person removed; replaced by C-52.</sup:constraintNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-31">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-31</sup:constraintId>
    <rdfs:label>C-31</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>A Ticket is assigned to at most one SupportAgent at a time.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-32">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-32</sup:constraintId>
    <rdfs:label>C-32</rdfs:label>
    <sup:enforcementLevel>Soft</sup:enforcementLevel>
    <sup:constraintText>An inactive SupportAgent must not hold open tickets.</sup:constraintText>
    <sup:status>Active</sup:status>
    <sup:constraintNote>Tickets orphaned when someone leaves. Real, common, and invisible until a customer chases.</sup:constraintNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-33">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-33</sup:constraintId>
    <rdfs:label>C-33</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>Every JiraIssue in scope traces back to at least one Escalation. Engineering-initiated issues are out of scope and must not be loaded.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-34">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-34</sup:constraintId>
    <rdfs:label>C-34</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>JiraIssue.isResolved is derived from a per-project status mapping, not from the raw status string. Jira projects use different workflows and "Done" is not universal.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-35">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-35</sup:constraintId>
    <rdfs:label>C-35</rdfs:label>
    <sup:enforcementLevel>Soft</sup:enforcementLevel>
    <sup:constraintText>A resolved JiraIssue with unresolved originating Tickets.</sup:constraintText>
    <sup:status>Active</sup:status>
    <sup:constraintNote>The fix shipped and nobody told the customer. Probably the highest-value check here.</sup:constraintNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-36">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-36</sup:constraintId>
    <rdfs:label>C-36</rdfs:label>
    <sup:enforcementLevel>Retired</sup:enforcementLevel>
    <sup:constraintText>Every JiraIssue owned by one DevelopmentTeam</sup:constraintText>
    <sup:status>Retired</sup:status>
    <sup:constraintNote>DevelopmentTeam out of scope.</sup:constraintNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-37">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-37</sup:constraintId>
    <rdfs:label>C-37</rdfs:label>
    <sup:enforcementLevel>Retired</sup:enforcementLevel>
    <sup:constraintText>Every Product has an owning DevelopmentTeam</sup:constraintText>
    <sup:status>Retired</sup:status>
    <sup:constraintNote>DevelopmentTeam out of scope.</sup:constraintNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-38">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-38</sup:constraintId>
    <rdfs:label>C-38</rdfs:label>
    <sup:enforcementLevel>Retired</sup:enforcementLevel>
    <sup:constraintText>AI-indexed articles must be public</sup:constraintText>
    <sup:status>Retired</sup:status>
    <sup:constraintNote>AIAssistant deferred.</sup:constraintNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-39">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-39</sup:constraintId>
    <rdfs:label>C-39</rdfs:label>
    <sup:enforcementLevel>Retired</sup:enforcementLevel>
    <sup:constraintText>Articles with no inbound link are orphans</sup:constraintText>
    <sup:status>Retired</sup:status>
    <sup:constraintNote>Article link graph left to the KB evaluation tooling.</sup:constraintNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-40">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-40</sup:constraintId>
    <rdfs:label>C-40</rdfs:label>
    <sup:enforcementLevel>Advisory</sup:enforcementLevel>
    <sup:constraintText>Documentation not reviewed in 24 months is a review candidate.</sup:constraintText>
    <sup:status>Active</sup:status>
    <sup:constraintNote>Stale content agents are still trusting.</sup:constraintNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-41">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-41</sup:constraintId>
    <rdfs:label>C-41</rdfs:label>
    <sup:enforcementLevel>Retired</sup:enforcementLevel>
    <sup:constraintText>No article may be its own ancestor</sup:constraintText>
    <sup:status>Retired</sup:status>
    <sup:constraintNote>Article link graph removed.</sup:constraintNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-42">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-42</sup:constraintId>
    <rdfs:label>C-42</rdfs:label>
    <sup:enforcementLevel>Retired</sup:enforcementLevel>
    <sup:constraintText>Every AIAssistant is grounded in ≥1 article</sup:constraintText>
    <sup:status>Retired</sup:status>
    <sup:constraintNote>AIAssistant deferred.</sup:constraintNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-43">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-43</sup:constraintId>
    <rdfs:label>C-43</rdfs:label>
    <sup:enforcementLevel>Retired</sup:enforcementLevel>
    <sup:constraintText>Article changes trigger re-indexing</sup:constraintText>
    <sup:status>Retired</sup:status>
    <sup:constraintNote>AIAssistant deferred.</sup:constraintNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-44">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-44</sup:constraintId>
    <rdfs:label>C-44</rdfs:label>
    <sup:enforcementLevel>Retired</sup:enforcementLevel>
    <sup:constraintText>Unemployed Person holds no active roles</sup:constraintText>
    <sup:status>Retired</sup:status>
    <sup:constraintNote>Person removed.</sup:constraintNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-45">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-45</sup:constraintId>
    <rdfs:label>C-45</rdfs:label>
    <sup:enforcementLevel>Retired</sup:enforcementLevel>
    <sup:constraintText>Every role instance held by exactly one Person</sup:constraintText>
    <sup:status>Retired</sup:status>
    <sup:constraintNote>Person removed.</sup:constraintNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-46">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-46</sup:constraintId>
    <rdfs:label>C-46</rdfs:label>
    <sup:enforcementLevel>Soft</sup:enforcementLevel>
    <sup:constraintText>An Account's SalesRepresentative must cover the Account's Region. This is "assigned depending on the region" made checkable — and it is the constraint most likely to fail after a territory reshuffle.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-47">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-47</sup:constraintId>
    <rdfs:label>C-47</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>An Account has at most one CustomerSuccessManager.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-48">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-48</sup:constraintId>
    <rdfs:label>C-48</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>Every Ticket is recorded in exactly one CRM.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-49">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-49</sup:constraintId>
    <rdfs:label>C-49</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>A fact from a CRM with isAuthoritative = false must not override a fact from an authoritative system for the same property. Mirrors lag.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-50">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-50</sup:constraintId>
    <rdfs:label>C-50</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>Every CRM declares ticketTermUsed. A system whose vocabulary is unknown cannot have its records safely translated.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-51">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-51</sup:constraintId>
    <rdfs:label>C-51</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>Every Product declares usesPlatinumNaming and severityTermUsed. A product whose support vocabulary is unknown cannot have its tickets safely compared against another product's.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-52">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-52</sup:constraintId>
    <rdfs:label>C-52</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>SupportAgent, SalesRepresentative and CustomerSuccessManager are pairwise disjoint. These are three distinct jobs in the support and commercial organization.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-53">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-53</sup:constraintId>
    <rdfs:label>C-53</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>Every License is bound to exactly one SupportEntitlement.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-54">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-54</sup:constraintId>
    <rdfs:label>C-54</rdfs:label>
    <sup:enforcementLevel>Soft</sup:enforcementLevel>
    <sup:constraintText>A License's SupportEntitlement should match its Account's SupportEntitlement.</sup:constraintText>
    <sup:status>Active</sup:status>
    <sup:constraintNote>The model's own open question, made checkable. If accounts routinely hold licenses at different tiers, entitlement belongs on the license and C-02 is wrong. Flagging rather than rejecting means the first real violation tells us which model is right, instead of the data being quietly reshaped to fit our guess. See OQ-42.</sup:constraintNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-55">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-55</sup:constraintId>
    <rdfs:label>C-55</rdfs:label>
    <sup:enforcementLevel>Soft</sup:enforcementLevel>
    <sup:constraintText>Every Documentation instance describes exactly one Product. Cross-product overview pages legitimately exist, so this flags rather than rejects.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-56">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-56</sup:constraintId>
    <rdfs:label>C-56</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>Every Ticket has exactly one SLA, determined by its SeverityLevel and Account's SupportEntitlement.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#C-57">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#Constraint"/>
    <sup:constraintId>C-57</sup:constraintId>
    <rdfs:label>C-57</rdfs:label>
    <sup:enforcementLevel>Hard</sup:enforcementLevel>
    <sup:constraintText>A Ticket raised by a Partner must belong to an Account that the Partner represents.</sup:constraintText>
    <sup:status>Active</sup:status>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-01</sup:questionId>
    <rdfs:label>CQ-01</rdfs:label>
    <sup:questionText>Which accounts in a given region have open tickets?</sup:questionText>
    <sup:questionStatus>Answerable</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-02</sup:questionId>
    <rdfs:label>CQ-02</rdfs:label>
    <sup:questionText>How many open tickets does each entitlement tier have, by severity?</sup:questionText>
    <sup:questionStatus>Conditional</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-03</sup:questionId>
    <rdfs:label>CQ-03</rdfs:label>
    <sup:questionText>Which Premium accounts have tickets open longer than N days?</sup:questionText>
    <sup:questionStatus>Conditional</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-04">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-04</sup:questionId>
    <rdfs:label>CQ-04</rdfs:label>
    <sup:questionText>Which products is an account licensed for?</sup:questionText>
    <sup:questionStatus>Answerable</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-05">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-05</sup:questionId>
    <rdfs:label>CQ-05</rdfs:label>
    <sup:questionText>Who owns account X commercially, and is that assignment valid?</sup:questionText>
    <sup:questionStatus>Answerable</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-06">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-06</sup:questionId>
    <rdfs:label>CQ-06</rdfs:label>
    <sup:questionText>Which contacts at an account have raised tickets, and how many?</sup:questionText>
    <sup:questionStatus>Conditional</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-07">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-07</sup:questionId>
    <rdfs:label>CQ-07</rdfs:label>
    <sup:questionText>What does a given product and CRM call a ticket, a severity, and the premium tier?</sup:questionText>
    <sup:questionStatus>Conditional</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-08">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-08</sup:questionId>
    <rdfs:label>CQ-08</rdfs:label>
    <sup:questionText>Compare high-severity ticket volume across products.</sup:questionText>
    <sup:questionStatus>Conditional</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-09">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-09</sup:questionId>
    <rdfs:label>CQ-09</rdfs:label>
    <sup:questionText>Which tickets came from accounts with no active license for that product?</sup:questionText>
    <sup:questionStatus>Answerable</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-10">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-10</sup:questionId>
    <rdfs:label>CQ-10</rdfs:label>
    <sup:questionText>What is each agent's open ticket load, by severity?</sup:questionText>
    <sup:questionStatus>Answerable</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-11">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-11</sup:questionId>
    <rdfs:label>CQ-11</rdfs:label>
    <sup:questionText>Which Premium accounts are blocked on an unresolved Jira issue?</sup:questionText>
    <sup:questionStatus>Conditional</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-12">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-12</sup:questionId>
    <rdfs:label>CQ-12</rdfs:label>
    <sup:questionText>Which products have support load but thin documentation?</sup:questionText>
    <sup:questionStatus>Answerable</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-13">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-13</sup:questionId>
    <rdfs:label>CQ-13</rdfs:label>
    <sup:questionText>Which licenses expire in 90 days for accounts with open tickets?</sup:questionText>
    <sup:questionStatus>Answerable</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-14">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-14</sup:questionId>
    <rdfs:label>CQ-14</rdfs:label>
    <sup:questionText>Which strategic accounts in region R have no CSM?</sup:questionText>
    <sup:questionStatus>Answerable</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-15">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-15</sup:questionId>
    <rdfs:label>CQ-15</rdfs:label>
    <sup:questionText>How many tickets did each agent escalate, and at what severity?</sup:questionText>
    <sup:questionStatus>Answerable</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-16">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-16</sup:questionId>
    <rdfs:label>CQ-16</rdfs:label>
    <sup:questionText>For product P, which agents specialise in it and what docs exist?</sup:questionText>
    <sup:questionStatus>Answerable</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-17">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-17</sup:questionId>
    <rdfs:label>CQ-17</rdfs:label>
    <sup:questionText>Which unresolved bugs have the highest-severity tickets attached?</sup:questionText>
    <sup:questionStatus>Answerable</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-18">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-18</sup:questionId>
    <rdfs:label>CQ-18</rdfs:label>
    <sup:questionText>Who escalated issue X, when, and why?</sup:questionText>
    <sup:questionStatus>Answerable</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-19">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-19</sup:questionId>
    <rdfs:label>CQ-19</rdfs:label>
    <sup:questionText>How many accounts are waiting on Jira issue X, and who owns them?</sup:questionText>
    <sup:questionStatus>Conditional</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-20">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-20</sup:questionId>
    <rdfs:label>CQ-20</rdfs:label>
    <sup:questionText>Which tickets were opened after the contact used the AI assistant?</sup:questionText>
    <sup:questionStatus>Retired</sup:questionStatus>
    <sup:questionNote>AIAssistant deferred.</sup:questionNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-21">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-21</sup:questionId>
    <rdfs:label>CQ-21</rdfs:label>
    <sup:questionText>Which documentation articles are orphans?</sup:questionText>
    <sup:questionStatus>Retired</sup:questionStatus>
    <sup:questionNote>Article link graph left to the KB evaluation tooling.</sup:questionNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-22">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-22</sup:questionId>
    <rdfs:label>CQ-22</rdfs:label>
    <sup:questionText>What is the full commercial picture of account X?</sup:questionText>
    <sup:questionStatus>Answerable</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-23">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-23</sup:questionId>
    <rdfs:label>CQ-23</rdfs:label>
    <sup:questionText>Do Premium tickets get escalated faster than Standard?</sup:questionText>
    <sup:questionStatus>Conditional</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-24">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-24</sup:questionId>
    <rdfs:label>CQ-24</rdfs:label>
    <sup:questionText>Which documentation resolves the most tickets?</sup:questionText>
    <sup:questionStatus>Answerable</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-25">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-25</sup:questionId>
    <rdfs:label>CQ-25</rdfs:label>
    <sup:questionText>What share of a product's public articles ground the assistant?</sup:questionText>
    <sup:questionStatus>Retired</sup:questionStatus>
    <sup:questionNote>AIAssistant deferred.</sup:questionNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-26">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-26</sup:questionId>
    <rdfs:label>CQ-26</rdfs:label>
    <sup:questionText>Which topics generate high-severity tickets but have no documentation?</sup:questionText>
    <sup:questionStatus>Answerable</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-27">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-27</sup:questionId>
    <rdfs:label>CQ-27</rdfs:label>
    <sup:questionText>What is the escalation rate by tier and severity?</sup:questionText>
    <sup:questionStatus>Conditional</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-28">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
    <sup:questionId>CQ-28</sup:questionId>
    <rdfs:label>CQ-28</rdfs:label>
    <sup:questionText>Which dev teams carry the most escalations?</sup:questionText>
    <sup:questionStatus>Retired</sup:questionStatus>
    <sup:questionNote>DevelopmentTeam out of scope.</sup:questionNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#CQ-29">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#CompetencyQuestion"/>
