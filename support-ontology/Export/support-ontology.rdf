  <rdf:Description rdf:about="https://ontology.local/support#Escalation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Escalation</rdfs:label>
    <skos:prefLabel>Escalation</skos:prefLabel>
    <skos:definition>The act of a support agent referring a ticket to development because it has been identified as a defect or as a request for new functionality. The Escalation produces a Jira issue and is the only legitimate way a Jira ID becomes associated with a ticket.</skos:definition>
    <rdfs:comment>The act of a support agent referring a ticket to development because it has been identified as a defect or as a request for new functionality. The Escalation produces a Jira issue and is the only legitimate way a Jira ID becomes associated with a ticket.</rdfs:comment>
    <sup:domainType>Support</sup:domainType>
    <sup:status>Canonical</sup:status>
    <sup:identityRule>Surrogate: generated UUID. There is no natural key — the same ticket can be escalated more than once, and the same Jira issue can receive escalations from many tickets.</sup:identityRule>
    <sup:sourceFile>Ontology/Entities/Escalation.md</sup:sourceFile>
    <skos:altLabel>Bug report</skos:altLabel>
    <skos:altLabel>Dev handoff</skos:altLabel>
    <skos:altLabel>raising a Jira</skos:altLabel>
    <sup:hasAlias rdf:nodeID="b26"/>
