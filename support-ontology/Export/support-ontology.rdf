  <rdf:Description rdf:about="https://ontology.local/support#JiraIssue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>JiraIssue</rdfs:label>
    <skos:prefLabel>JiraIssue</skos:prefLabel>
    <skos:definition>A unit of engineering work tracked in Jira, created as the result of a support escalation, representing either a defect to fix or a capability to build. Its key is the identifier that gets associated back to the originating ticket.</skos:definition>
    <rdfs:comment>A unit of engineering work tracked in Jira, created as the result of a support escalation, representing either a defect to fix or a capability to build. Its key is the identifier that gets associated back to the originating ticket.</rdfs:comment>
    <sup:domainType>Engineering</sup:domainType>
    <sup:status>Canonical</sup:status>
    <sup:identityRule>The Jira issue key (e.g. `PROJ-1234`) is authoritative and globally unique.</sup:identityRule>
    <sup:sourceFile>Ontology/Entities/JiraIssue.md</sup:sourceFile>
