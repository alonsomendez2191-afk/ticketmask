    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>SeverityLevel</rdfs:label>
    <skos:prefLabel>SeverityLevel</skos:prefLabel>
    <skos:definition>The graded measure of a ticket's business impact and urgency, used to set response expectations and routing. Every ticket has exactly one.</skos:definition>
    <rdfs:comment>The graded measure of a ticket's business impact and urgency, used to set response expectations and routing. Every ticket has exactly one.</rdfs:comment>
    <sup:domainType>Support</sup:domainType>
    <sup:status>Canonical</sup:status>
    <sup:identityRule>Natural key: the canonical level code `S1`–`S4`. All product-specific labels (`P1`, `Critical`, `High`, `1 - Urgent`) resolve to one of these four.</sup:identityRule>
    <sup:sourceFile>Ontology/Entities/SeverityLevel.md</sup:sourceFile>
