  <rdf:Description rdf:about="https://ontology.local/support#Region">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Region</rdfs:label>
    <skos:prefLabel>Region</skos:prefLabel>
    <skos:definition>A geographic territory used to distribute accounts and assign commercial and support coverage. Regions determine which sales representative owns an account and which support team's working hours apply to its tickets.</skos:definition>
    <rdfs:comment>A geographic territory used to distribute accounts and assign commercial and support coverage. Regions determine which sales representative owns an account and which support team's working hours apply to its tickets.</rdfs:comment>
    <sup:domainType>Customer</sup:domainType>
    <sup:status>Canonical</sup:status>
    <sup:identityRule>Natural key: the region code (`EMEA`, `NA`, `APAC`, `LATAM`). Codes are stable and never reused.</sup:identityRule>
    <sup:sourceFile>Ontology/Entities/Region.md</sup:sourceFile>
