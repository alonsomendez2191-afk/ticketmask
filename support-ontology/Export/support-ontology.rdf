    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Documentation</rdfs:label>
    <skos:prefLabel>Documentation</skos:prefLabel>
    <skos:definition>Published product documentation and knowledge base content that support agents consult to resolve tickets. One instance is one published unit — an article or page — identified by its URL.</skos:definition>
    <rdfs:comment>Published product documentation and knowledge base content that support agents consult to resolve tickets. One instance is one published unit — an article or page — identified by its URL.</rdfs:comment>
    <sup:domainType>Knowledge</sup:domainType>
    <sup:status>Canonical</sup:status>
    <sup:identityRule>The published URL is authoritative. Where content exists at several URLs (localised or mirrored), the canonical URL is the identity and the others are recorded as aliases.</sup:identityRule>
    <sup:sourceFile>Ontology/Entities/Documentation.md</sup:sourceFile>
