  <rdf:Description rdf:about="https://ontology.local/support#CustomerSuccessManager">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>CustomerSuccessManager</rdfs:label>
    <skos:prefLabel>CustomerSuccessManager</skos:prefLabel>
    <skos:definition>An internal individual assigned to accounts considered valuable, with responsibility for adoption, retention and relationship health. Unlike the sales representative, CSM assignment is conditional — most accounts do not have one.</skos:definition>
    <rdfs:comment>An internal individual assigned to accounts considered valuable, with responsibility for adoption, retention and relationship health. Unlike the sales representative, CSM assignment is conditional — most accounts do not have one.</rdfs:comment>
    <sup:domainType>Customer</sup:domainType>
    <sup:status>Canonical</sup:status>
    <sup:identityRule>The CRM user ID is authoritative.</sup:identityRule>
