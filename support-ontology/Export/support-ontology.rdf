  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#OQ-51">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#OpenQuestion"/>
    <sup:questionId>OQ-51</sup:questionId>
    <rdfs:label>OQ-51</rdfs:label>
    <sup:questionText>Does live CRM data conform to the four-level standard?</sup:questionText>
    <sup:questionStatus>Open</sup:questionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#EQ-01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#EquivalenceDeclaration"/>
    <sup:equivalenceId>EQ-01</sup:equivalenceId>
    <rdfs:label>EQ-01: Ticket ≡ Case</rdfs:label>
    <sup:canonicalTerm rdf:resource="https://ontology.local/support#Ticket"/>
    <sup:equivalentLabel>Case</sup:equivalentLabel>
    <sup:equivalentLabel>Incident</sup:equivalentLabel>
    <sup:equivalentLabel>SR</sup:equivalentLabel>
    <sup:equivalentLabel>Service Request</sup:equivalentLabel>
    <sup:variesBy>CRM system</sup:variesBy>
    <sup:anchorProperty>sup:CRM.ticketTermUsed</sup:anchorProperty>
    <sup:equivalenceStatus>Canonical. Per-system mapping populated per organization in Entities/CRM.md (OQ-50). Example: Salesforce → Case, Zendesk → Ticket.</sup:equivalenceStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#EQ-02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#EquivalenceDeclaration"/>
    <sup:equivalenceId>EQ-02</sup:equivalenceId>
    <rdfs:label>EQ-02: Premium Support ≡ Platinum Support</rdfs:label>
    <sup:canonicalTerm rdf:resource="https://ontology.local/support#SupportEntitlement"/>
    <sup:equivalentLabel>Platinum</sup:equivalentLabel>
    <sup:equivalentLabel>Platinum Support</sup:equivalentLabel>
    <sup:variesBy>Product</sup:variesBy>
    <sup:anchorProperty>sup:Product.usesPlatinumNaming</sup:anchorProperty>
    <sup:equivalenceStatus>Canonical. Which products use Platinum naming is not populated (OQ-07). Interim rule, 2026-08-20: treat Platinum and Premium as synonyms unconditionally — either label resolves to tierCode = PREMIUM regardless of product. Tier counts are correct under this rule; "which label should this product be showing?" is not answerable until OQ-07 closes.</sup:equivalenceStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#EQ-03">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#EquivalenceDeclaration"/>
    <sup:equivalenceId>EQ-03</sup:equivalenceId>
    <rdfs:label>EQ-03: Severity ≡ Priority</rdfs:label>
    <sup:canonicalTerm rdf:resource="https://ontology.local/support#SeverityLevel"/>
    <sup:equivalentLabel>Priority</sup:equivalentLabel>
    <sup:equivalentLabel>Pri</sup:equivalentLabel>
    <sup:equivalentLabel>Sev</sup:equivalentLabel>
    <sup:equivalentLabel>Impact</sup:equivalentLabel>
    <sup:variesBy>Product</sup:variesBy>
    <sup:anchorProperty>sup:Product.severityTermUsed</sup:anchorProperty>
    <sup:equivalenceStatus>Canonical for the term split. Value-level standard set 2026-08-20 (OQ-19): four levels, S1–S4, uniform across all products, definitions on SeverityLevel. Whether live CRM data conforms is still unverified (OQ-51).</sup:equivalenceStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#EQ-04">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.local/support#EquivalenceDeclaration"/>
    <sup:equivalenceId>EQ-04</sup:equivalenceId>
    <rdfs:label>EQ-04: "Ticket" is ambiguous across support and development</rdfs:label>
    <sup:canonicalTerm rdf:resource="https://ontology.local/support#Ticket"/>
    <sup:canonicalTerm rdf:resource="https://ontology.local/support#JiraIssue"/>
    <sup:equivalenceStatus>Disjoint — see 04-Constraints-and-Rules.md</sup:equivalenceStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.local/support#canonicalTerm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label>canonicalTerm</rdfs:label>
  </rdf:Description>
</rdf:RDF>
