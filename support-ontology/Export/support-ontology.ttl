sup:Account
        rdf:type owl:Class ;
        rdfs:label "Account" ;
        skos:prefLabel "Account" ;
        skos:definition "A commercial customer organization that holds one or more licenses to our products and is entitled to receive support. The Account is the unit that entitlement, licensing, regional assignment and commercial ownership all hang off. An Account is an organization, never an individual person — the people at an account are modelled as `sup:Contact`." ;
        rdfs:comment "A commercial customer organization that holds one or more licenses to our products and is entitled to receive support. The Account is the unit that entitlement, licensing, regional assignment and commercial ownership all hang off. An Account is an organization, never an individual person — the people at an account are modelled as `sup:Contact`." ;
        sup:domainType "Customer" ;
        sup:status "Canonical" ;
        sup:identityRule "The CRM account ID is authoritative. Where an organization exists as multiple account records across brand-specific CRM orgs, they are the same `sup:Account` only if they share a resolved parent organization ID. See `OQ-03` — account de-duplication across brand orgs is unresolved." ;
        sup:sourceFile "Ontology/Entities/Account.md" ;
        skos:altLabel "Account" ;
        sup:hasAlias [
                rdf:type sup:Alias ;
                sup:aliasTerm "Account" ;
                sup:aliasContext "Salesforce"
        ] ;
