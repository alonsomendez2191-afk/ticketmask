sup:Product
        rdf:type owl:Class ;
        rdfs:label "Product" ;
        skos:prefLabel "Product" ;
        skos:definition "A software product that customers license and raise support tickets about. The Product is what a license grants access to, what a ticket concerns, and what documentation describes. It is the join point between the commercial, support and knowledge parts of the model." ;
        rdfs:comment "A software product that customers license and raise support tickets about. The Product is what a license grants access to, what a ticket concerns, and what documentation describes. It is the join point between the commercial, support and knowledge parts of the model." ;
        sup:domainType "Product" ;
        sup:status "Canonical" ;
        sup:identityRule "The licensing system product ID is authoritative. Version is not part of identity — a product and its versions are the same product. Version-specific facts would need `sup:ProductVersion`, which is not modelled (`OQ-15`)." ;
