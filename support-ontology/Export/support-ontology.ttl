sup:EQ-01
        rdf:type owl:NamedIndividual ;
        rdf:type sup:EquivalenceDeclaration ;
        sup:equivalenceId "EQ-01" ;
        rdfs:label "EQ-01: Ticket ≡ Case" ;
        sup:canonicalTerm sup:Ticket ;
        sup:equivalentLabel "Case" ;
        sup:equivalentLabel "Incident" ;
        sup:equivalentLabel "SR" ;
        sup:equivalentLabel "Service Request" ;
        sup:variesBy "CRM system" ;
        sup:anchorProperty "sup:CRM.ticketTermUsed" ;
        sup:equivalenceStatus "Canonical. Per-system mapping populated per organization in Entities/CRM.md (OQ-50). Example: Salesforce → Case, Zendesk → Ticket." .

sup:EQ-02
        rdf:type owl:NamedIndividual ;
        rdf:type sup:EquivalenceDeclaration ;
        sup:equivalenceId "EQ-02" ;
        rdfs:label "EQ-02: Premium Support ≡ Platinum Support" ;
        sup:canonicalTerm sup:SupportEntitlement ;
        sup:equivalentLabel "Platinum" ;
        sup:equivalentLabel "Platinum Support" ;
        sup:variesBy "Product" ;
        sup:anchorProperty "sup:Product.usesPlatinumNaming" ;
        sup:equivalenceStatus "Canonical. Which products use Platinum naming is not populated (OQ-07). Interim rule, 2026-08-20: treat Platinum and Premium as synonyms unconditionally — either label resolves to tierCode = PREMIUM regardless of product. Tier counts are correct under this rule; \"which label should this product be showing?\" is not answerable until OQ-07 closes." .

sup:EQ-03
        rdf:type owl:NamedIndividual ;
        rdf:type sup:EquivalenceDeclaration ;
        sup:equivalenceId "EQ-03" ;
        rdfs:label "EQ-03: Severity ≡ Priority" ;
        sup:canonicalTerm sup:SeverityLevel ;
        sup:equivalentLabel "Priority" ;
        sup:equivalentLabel "Pri" ;
        sup:equivalentLabel "Sev" ;
        sup:equivalentLabel "Impact" ;
        sup:variesBy "Product" ;
        sup:anchorProperty "sup:Product.severityTermUsed" ;
        sup:equivalenceStatus "Canonical for the term split. Value-level standard set 2026-08-20 (OQ-19): four levels, S1–S4, uniform across all products, definitions on SeverityLevel. Whether live CRM data conforms is still unverified (OQ-51)." .

sup:EQ-04
        rdf:type owl:NamedIndividual ;
        rdf:type sup:EquivalenceDeclaration ;
        sup:equivalenceId "EQ-04" ;
        rdfs:label "EQ-04: \"Ticket\" is ambiguous across support and development" ;
        sup:canonicalTerm sup:Ticket ;
        sup:canonicalTerm sup:JiraIssue ;
        sup:equivalenceStatus "Disjoint — see 04-Constraints-and-Rules.md" .

sup:canonicalTerm
        rdf:type owl:AnnotationProperty ;
        rdfs:label "canonicalTerm" .

