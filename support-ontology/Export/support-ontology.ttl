sup:SLA
        rdf:type owl:Class ;
        rdfs:label "SLA" ;
        skos:prefLabel "SLA" ;
        skos:definition "The Service Level Agreement that governs a ticket, dictating the target times for response and resolution. An SLA is determined by the severity of the ticket and the entitlement of the customer account. Support agents are measured against their ability to meet these SLA targets." ;
        rdfs:comment "The Service Level Agreement that governs a ticket, dictating the target times for response and resolution. An SLA is determined by the severity of the ticket and the entitlement of the customer account. Support agents are measured against their ability to meet these SLA targets." ;
        sup:domainType "Support" ;
        sup:status "Proposed" ;
        sup:identityRule "A composite of `severityLevel` + `entitlementTier`." ;
        sup:sourceFile "Ontology/Entities/SLA.md" ;
        skos:altLabel "Service Level Agreement" ;
        sup:hasAlias [
                rdf:type sup:Alias ;
                sup:aliasTerm "Service Level Agreement" ;
                sup:aliasContext "CRM"
        ] ;
        skos:altLabel "SLA" ;
        sup:hasAlias [
                rdf:type sup:Alias ;
                sup:aliasTerm "SLA" ;
                sup:aliasContext "ITSM"
        ] ;
        sup:hasProvenance [
                rdf:type sup:ProvenanceEntry ;
                sup:sourceSystem "CRM" ;
                sup:supplies "SLA matrix configuration" ;
                sup:authoritativeFor "targetResponseMinutes, targetResolutionMinutes"
        ] ;
        sup:governedBy sup:C-56 ;
        sup:answersQuestion sup:CQ-30 ;
        sup:answersQuestion sup:CQ-31 ;
        sup:raisesQuestion sup:OQ-48 ;
        owl:disjointWith sup:Ticket ;
        owl:disjointWith sup:SeverityLevel ;
        owl:disjointWith sup:SupportEntitlement ;
        rdfs:subClassOf [
                rdf:type owl:Restriction ;
                owl:onProperty sup:slaName ;
                owl:minCardinality "1"^^xsd:nonNegativeInteger
        ] ;
        rdfs:subClassOf [
                rdf:type owl:Restriction ;
                owl:onProperty sup:targetResponseMinutes ;
                owl:minCardinality "1"^^xsd:nonNegativeInteger
        ] ;
        rdfs:subClassOf [
                rdf:type owl:Restriction ;
                owl:onProperty sup:targetResolutionMinutes ;
                owl:minCardinality "1"^^xsd:nonNegativeInteger
        ] .

sup:SupportAgent
        rdf:type owl:Class ;
        rdfs:label "SupportAgent" ;
        skos:prefLabel "SupportAgent" ;
        skos:definition "An internal member of the support organization who is assigned tickets, resolves them using documentation, and escalates to development when a ticket is caused by a defect or requires new functionality." ;
        rdfs:comment "An internal member of the support organization who is assigned tickets, resolves them using documentation, and escalates to development when a ticket is caused by a defect or requires new functionality." ;
        sup:domainType "Support" ;
        sup:status "Canonical" ;
        sup:identityRule "The CRM user ID is authoritative. Agents appearing in more than one CRM are matched on corporate email." ;
        sup:sourceFile "Ontology/Entities/SupportAgent.md" ;
        skos:altLabel "Case owner" ;
        skos:altLabel "Assigned to" ;
        skos:altLabel "Owner" ;
        sup:hasAlias [
