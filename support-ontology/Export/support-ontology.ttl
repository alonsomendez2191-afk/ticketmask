sup:License
        rdf:type owl:Class ;
        rdfs:label "License" ;
        skos:prefLabel "License" ;
        skos:definition "A grant of the right to use a specific product, held by a specific account, for a defined period and quantity. The license is what makes a support request legitimate: an account may only raise tickets about products it is licensed for." ;
        rdfs:comment "A grant of the right to use a specific product, held by a specific account, for a defined period and quantity. The license is what makes a support request legitimate: an account may only raise tickets about products it is licensed for." ;
        sup:domainType "Customer" ;
        sup:status "Canonical" ;
        sup:identityRule "Composite: `accountId` + `productId` + `startDate`. A renewal produces a new License instance rather than mutating the existing one, so that historical coverage questions stay answerable." ;
        sup:sourceFile "Ontology/Entities/License.md" ;
        skos:altLabel "Asset" ;
        sup:hasAlias [
