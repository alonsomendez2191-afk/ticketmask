sup:SeverityLevel
        rdf:type owl:Class ;
        rdfs:label "SeverityLevel" ;
        skos:prefLabel "SeverityLevel" ;
        skos:definition "The graded measure of a ticket's business impact and urgency, used to set response expectations and routing. Every ticket has exactly one." ;
        rdfs:comment "The graded measure of a ticket's business impact and urgency, used to set response expectations and routing. Every ticket has exactly one." ;
        sup:domainType "Support" ;
        sup:status "Canonical" ;
        sup:identityRule "Natural key: the canonical level code `S1`–`S4`. All product-specific labels (`P1`, `Critical`, `High`, `1 - Urgent`) resolve to one of these four." ;
        sup:sourceFile "Ontology/Entities/SeverityLevel.md" ;
