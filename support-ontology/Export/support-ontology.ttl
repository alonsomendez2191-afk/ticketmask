sup:SupportEntitlement
        rdf:type owl:Class ;
        rdfs:label "SupportEntitlement" ;
        skos:prefLabel "SupportEntitlement" ;
        skos:definition "The tier of support service an account is entitled to receive. The tier governs response time targets, escalation rights and channel access. Entitlement is a property of the account, not of an individual ticket or license." ;
        rdfs:comment "The tier of support service an account is entitled to receive. The tier governs response time targets, escalation rights and channel access. Entitlement is a property of the account, not of an individual ticket or license." ;
        sup:domainType "Customer" ;
        sup:status "Canonical" ;
        sup:identityRule "Natural key: the canonical tier code (`STANDARD`, `PREMIUM`). Entitlement is a controlled vocabulary, not a per-account record — the per-account fact is the `hasEntitlement` link, and its effective dates live on the link." ;
        sup:sourceFile "Ontology/Entities/SupportEntitlement.md" ;
        skos:altLabel "Support Level" ;
        skos:altLabel "Support Plan" ;
        sup:hasAlias [
