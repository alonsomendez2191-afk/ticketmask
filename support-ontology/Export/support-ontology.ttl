sup:Region
        rdf:type owl:Class ;
        rdfs:label "Region" ;
        skos:prefLabel "Region" ;
        skos:definition "A geographic territory used to distribute accounts and assign commercial and support coverage. Regions determine which sales representative owns an account and which support team's working hours apply to its tickets." ;
        rdfs:comment "A geographic territory used to distribute accounts and assign commercial and support coverage. Regions determine which sales representative owns an account and which support team's working hours apply to its tickets." ;
