# Fernet key for encrypting the PII vault at rest.
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# In production this belongs in a KMS / Key Vault, not a file.
TICKETMASK_VAULT_KEY=

# Where reverse-mapping vaults are written. Treat this directory as PII.
TICKETMASK_VAULT_DIR=./vault

# Ontology folder (Ontology/ + Export/ layout). Defaults to the bundled ./support-ontology.
# TICKETMASK_ONTOLOGY_DIR=../my-ontology
